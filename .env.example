# Local development: copy to .env. Docker: copy to .env.production.
# Never overwrite an existing real env file or commit it. Default provider: DeepSeek.
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
FUYAO_API_KEY=
STOCKLENS_UNIVERSE_LIMIT=300
STOCKLENS_MIN_COVERAGE=0.8
STOCKLENS_DATA_DIR=data
STOCKLENS_ACCESS_MODE=required
STOCKLENS_ACCOUNT_DB=data/accounts.sqlite3
STOCKLENS_GLOBAL_DAILY_LIMIT=200

# Docker only: real domain without https:// or path; DNS points at the server.
# Caddy obtains HTTPS certificates; production sessions require HTTPS.
STOCKLENS_DOMAIN=
STOCKLENS_IMAGE_TAG=local
# Same-origin Docker deployment needs no CORS allowlist.
STOCKLENS_CORS_ORIGINS=
