# Copy to /etc/stocklens/api.env; permissions 600, owner stocklens.
OPENAI_API_KEY=replace_on_server
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
# Optional second provider; leave the key empty until configured.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
STOCKLENS_DATA_DIR=/var/lib/stocklens
# Production frontend and API share an origin through Caddy.
STOCKLENS_CORS_ORIGINS=
STOCKLENS_ACCESS_MODE=required
STOCKLENS_ACCOUNT_DB=/var/lib/stocklens/accounts.sqlite3
STOCKLENS_GLOBAL_DAILY_LIMIT=200
