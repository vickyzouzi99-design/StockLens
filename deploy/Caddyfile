{$STOCKLENS_DOMAIN} {
    encode zstd gzip
    request_body {
        max_size 1MB
    }
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
    }
    @api path /api /api/*
    handle @api {
        reverse_proxy api:8000 {
            # Only this proxy reaches the unpublished API port.
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
            transport http {
                dial_timeout 5s
                response_header_timeout 60s
            }
        }
    }
    handle {
        root * /srv
        @assets path /assets/*
        header @assets Cache-Control "public, max-age=31536000, immutable"
        # Revalidate the SPA document even on client-side routes.
        @document not path /assets/*
        header @document Cache-Control "no-cache"
        try_files {path} /index.html
        file_server
    }
}

# Container-only liveness: serve the built document without DNS/TLS dependencies.
http://127.0.0.1:8080 {
    root * /srv
    rewrite * /index.html
    file_server
}
